# =============================================================================
# VEHICLE BILL SAAS — ENVIRONMENT VARIABLES
# NEVER COMMIT REAL SECRET KEYS OR API CREDENTIALS TO VERSION CONTROL
# Copy this file to .env.local and fill in real values
# =============================================================================

# Supabase (from project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Payment provider (mock for now)
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Fuel Price API
FUEL_PRICE_API_KEY=your-rapidapi-key-here
FUEL_PRICE_CACHE_MINUTES=30
FUEL_PRICE_PROVIDER=rapidapi

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Payment flags
UPI_PAYMENT_ENABLED=true
PAYMENT_MODE=mock
