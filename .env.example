# =============================================================================
# VEHICLE BILL SAAS — SERVER-SIDE ENVIRONMENT VARIABLES
# NEVER COMMIT REAL SECRET KEYS OR API CREDENTIALS TO VERSION CONTROL
# =============================================================================

# Indian Fuel Price API Key (https://fuel.indianapi.in)
FUEL_PRICE_API_KEY=your_indian_api_key_here

# Fuel Price Server Cache Duration (Minutes)
FUEL_PRICE_CACHE_MINUTES=30

# Fuel Price Provider Selection: 'indianapi' | 'manual'
FUEL_PRICE_PROVIDER=indianapi

# Payment Integration Flags
UPI_PAYMENT_ENABLED=false
PAYMENT_MODE=mock
